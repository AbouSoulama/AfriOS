# Database
# Local sans Docker : SQLite
DATABASE_URL=sqlite+aiosqlite:///./afrios_dev.db
# Avec Docker/Postgres :
# DATABASE_URL=postgresql+asyncpg://afrios:afrios_dev@localhost:5432/afrios

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OTP
# true = code aussi renvoyé dans l'API (dev / beta sans SMS)
# false = SMS obligatoire via Africa's Talking
OTP_DEV_MODE=true
OTP_EXPIRE_MINUTES=5
OTP_RATE_LIMIT_MINUTES=15
OTP_RATE_LIMIT_MAX=5
OTP_MAX_ATTEMPTS=5
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
# Optionnel — sender ID / shortcode approuvé
AFRICAS_TALKING_SENDER=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# En prod (Render), pointer le webhook vers l'URL publique :
# CINETPAY_NOTIFY_URL=https://afrios-api.onrender.com/v1/webhooks/cinetpay
CINETPAY_NOTIFY_URL=http://localhost:8000/v1/webhooks/cinetpay
CINETPAY_RETURN_URL=afrios://payment/success
CINETPAY_SANDBOX=true
# URL publique utilisée pour les liens de paiement sandbox (Render / tunnel)
# PUBLIC_BASE_URL=https://afrios-api.onrender.com
PUBLIC_BASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase (FCM)
FIREBASE_CREDENTIALS_PATH=

# Cron journalier (Render Cron Job ou curl)
# POST /v1/jobs/daily  Header: X-Cron-Secret
JOBS_CRON_SECRET=dev-cron-secret

# App
APP_NAME=AfriOS API
APP_VERSION=1.0.0
CORS_ORIGINS=["*"]
API_PREFIX=/v1
