# Database
# Local sans Docker : SQLite
DATABASE_URL=sqlite+aiosqlite:///./afrios_dev.db
# Avec Docker/Postgres :
# DATABASE_URL=postgresql+asyncpg://afrios:afrios_dev@localhost:5432/afrios

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# OTP SMS (Africa's Talking)
# false = le code est envoyé UNIQUEMENT par SMS au numéro saisi
OTP_DEV_MODE=false
OTP_EXPIRE_MINUTES=5
OTP_RATE_LIMIT_MINUTES=15
OTP_RATE_LIMIT_MAX=5
OTP_MAX_ATTEMPTS=5
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# FedaPay (Mobile Money + abonnements)
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SANDBOX=true
# Prod Render :
# FEDAPAY_CALLBACK_URL=https://afrios-api.onrender.com/v1/webhooks/fedapay
FEDAPAY_CALLBACK_URL=http://localhost:8000/v1/webhooks/fedapay
FEDAPAY_RETURN_URL=afrios://payment/success

PUBLIC_BASE_URL=https://afrios-api.onrender.com

# OpenAI (optionnel — IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase (FCM)
FIREBASE_CREDENTIALS_PATH=

# Cron journalier
JOBS_CRON_SECRET=dev-cron-secret

# App
APP_NAME=AfriOS API
APP_VERSION=1.0.0
CORS_ORIGINS=["*"]
API_PREFIX=/v1
